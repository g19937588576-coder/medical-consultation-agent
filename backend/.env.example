# 大模型配置（OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat

# 医学资料 MCP 服务器
# 本地默认：node 运行 vendor/medical-mcp/build/index.js
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=["../vendor/medical-mcp/build/index.js"]

# 数据与缓存
DB_PATH=data/medical.db
TOOL_CACHE_TTL=3600

# 多轮追问上限
MAX_QUESTION_ROUNDS=12


